PROJECT_ID="your-gcp-project-id"
LOCATION="us-east1"
GCP_DOC_AI_LOCATION="us"
GCP_DOC_AI_PROCESSOR_ID="your-doc-ai-processor-id"
GCP_RAW_BUCKET="your-raw-bucket-name"
GCP_PROCESSED_BUCKET="your-processed-bucket-name"
VPC_CONNECTOR="default"

QDRANT_API_KEY="your-qdrant-api-key"
QDRANT_CLUSTER_ENDPOINT="https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io"

GROQ_API_KEY="gsk_your_groq_api_key"

# Observability
LOGFIRE_TOKEN="pylf_v1_your_token"

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_your_key
LANGSMITH_PROJECT="AI_Enterprise_RAG"
